{
  "name": "focus-beat",
  "version": "3.1.3",
  "private": true,
  "description": "Pomodoro desktop timer with focus and break audio",
  "author": "Focus Beat",
  "main": "electron/main.cjs",
  "scripts": {
    "dev": "vite --host 0.0.0.0",
    "desktop": "electron .",
    "build": "vite build",
    "dist:win": "npm run build && electron-builder --win nsis",
    "test": "node --test",
    "dist:win:portable": "npm run build && electron-builder --win zip -c.win.signAndEditExecutable=false",
    "dist:win:release": "npm run build && electron-builder --win nsis zip"
  },
  "build": {
    "appId": "com.focusbeat.desktop",
    "productName": "Focus Beat",
    "files": [
      "dist/**/*",
      "electron/**/*",
      "package.json"
    ],
    "win": {
      "target": "nsis",
      "requestedExecutionLevel": "asInvoker"
    },
    "nsis": {
      "oneClick": true,
      "perMachine": false,
      "allowToChangeInstallationDirectory": false,
      "packElevateHelper": false,
      "artifactName": "Focus-Beat-Setup-${version}.${ext}"
    },
    "directories": {
      "output": "release"
    }
  },
  "dependencies": {
    "@fontsource-variable/inter": "^5.3.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "devDependencies": {
    "electron": "^35.0.0",
    "electron-builder": "^26.0.0",
    "vite": "^6.0.0"
  }
}
